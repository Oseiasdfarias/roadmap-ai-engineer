---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Migalha from '../../components/Migalha.astro';
import Lateral from '../../components/Lateral.astro';
import LinhaTopico from '../../components/LinhaTopico.astro';
import PerfilCarreira from '../../components/PerfilCarreira.astro';
import AnteriorProximo from '../../components/AnteriorProximo.astro';
import { dicasDaFase, entradaDe, idProgresso } from '../../lib/conteudo';
import { idiomaDaUrl, link, tr } from '../../i18n/idioma';
import '../../styles/detalhe.css';

export async function getStaticPaths() {
  return (await getCollection('fases')).map((f) => ({ params: { id: String(f.id) } }));
}

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const lang = idiomaDaUrl(Astro.url.pathname);
const T = tr(lang, {
  pt: { fase: 'Fase', mapa: 'Mapa', carreira: 'Carreira', etq: (n: number) => `Carreira · fase ${n} de 5`, dicas: 'dicas', nota: 'Já trabalha com desenvolvimento ou dados? O estágio pode não ser o seu caminho.', notaLink: 'Veja a trilha para o seu perfil', prog: 'Progresso da fase', faseDe: 'fase de 05', k1: '01 — Dicas', oQue: 'O que fazer nesta fase', mesmo: 'No estudo, no mesmo período', nivel: 'Nível', nesta: 'No estudo, nesta fase', aprofundar: 'Aprofundar onde você quer ser sênior: design de sistemas com LLM, custo e segurança em escala.', k2: '02 — Critérios', terminou: 'Como saber que terminou' },
  en: { fase: 'Phase', mapa: 'Map', carreira: 'Career', etq: (n: number) => `Career · phase ${n} of 5`, dicas: 'tips', nota: 'Already working in software or data? An internship may not be your path.', notaLink: 'See the path for your profile', prog: 'Phase progress', faseDe: 'phase of 05', k1: '01 — Tips', oQue: 'What to do in this phase', mesmo: 'Studying in the same period', nivel: 'Level', nesta: 'Studying in this phase', aprofundar: 'Go deep where you want to be senior: LLM system design, cost and security at scale.', k2: '02 — Criteria', terminou: 'How to know you are done' },
});
const fase = (await entradaDe('fases', Astro.params.id!, lang))!;
const d = fase.data;
const [dicas, prev, next, niveis] = await Promise.all([
  dicasDaFase(d.id, lang),
  entradaDe('fases', String(d.id - 1), lang),
  entradaDe('fases', String(d.id + 1), lang),
  Promise.all(d.niveis.map((n) => entradaDe('niveis', String(n), lang))),
]);
const ids = dicas.map(idProgresso);
const rotulo = (f: NonNullable<typeof prev>) => `${T.fase} ${f.data.id} · ${cap(f.data.nome)}`;
---
<Base titulo={`${T.fase} ${d.id} · ${cap(d.nome)} | Roadmap AI Engineer`} descricao={d.objetivo} rotaOg={`fase/${d.id}`}>
  <div class="docs">
  <Lateral />
  <div class="detail">
    <Migalha itens={[{ rotulo: T.mapa, href: link(lang, '/') }, { rotulo: T.carreira }, { rotulo: `${T.fase} ${d.id}` }]} />
    <header class="pg-cab">
      <div class="pg-cab-txt">
        <div class="pg-meta">
          <span class="etq">{T.etq(d.id)}</span>
          <span class="dur">{d.quando} · {ids.length} {T.dicas}</span>
        </div>
        <h1>{cap(d.nome)}</h1>
        <p class="obj">{d.objetivo}</p>
        {d.id <= 2 && (
          <p class="nota-perfil" data-nota-perfil>{T.nota} <a href={link(lang, '/calculadora/')}>{T.notaLink}</a>.</p>
        )}
        {d.id <= 2 && <PerfilCarreira />}
        <div class="lp" data-progresso-conta={ids.join(',')}>
          <div class="track" role="progressbar" aria-label={T.prog} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span data-progresso-barra></span>
          </div>
          <small data-progresso-texto>0 / {ids.length}</small>
        </div>
      </div>
      <div class="pg-lado" aria-hidden="true"><div class="pg-num">{String(d.id).padStart(2, '0')}<small>{T.faseDe}</small></div></div>
    </header>

    <div class="pg-grade">
      <div class="cols">
        <div class="kicker">{T.k1}</div>
        <section class="grupo">
          <h2>{T.oQue}</h2>
          <div class="linhas">{dicas.map((x) => <LinhaTopico entry={x} />)}</div>
        </section>
      </div>

      <aside class="cross" aria-labelledby="no-estudo">
        {niveis.length > 0 ? (
          <>
            <h2 id="no-estudo">{T.mesmo}</h2>
            <ul class="niv-links">
              {niveis.map((n) => n && (
                <li>
                  <a href={link(lang, `/nivel/${n.data.id}/`)}>
                    <span><span class="k" data-perfil-duracao={n.data.id}>{n.data.duracao}</span>{T.nivel} {n.data.id} · {cap(n.data.curto)}</span>
                    <ArrowRight aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2 id="no-estudo">{T.nesta}</h2>
            <p class="sub">{T.aprofundar}</p>
          </>
        )}
      </aside>
    </div>

    <section class="pg-sec">
      <div class="kicker">{T.k2}</div>
      <h2>{T.terminou}</h2>
      <ol class="crit-lista">{d.criterios.map((c, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{c}</span></li>)}</ol>
    </section>

    <AnteriorProximo
      anterior={prev && { rotulo: rotulo(prev), href: link(lang, `/fase/${prev.data.id}/`) }}
      proximo={next && { rotulo: rotulo(next), href: link(lang, `/fase/${next.data.id}/`) }}
    />
  </div>
  </div>
</Base>
