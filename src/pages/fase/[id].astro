---
import { getCollection, getEntry } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Migalha from '../../components/Migalha.astro';
import LinhaTopico from '../../components/LinhaTopico.astro';
import AnteriorProximo from '../../components/AnteriorProximo.astro';
import { dicasDaFase, idProgresso } from '../../lib/conteudo';
import { url } from '../../lib/url';
import '../../styles/detalhe.css';

export async function getStaticPaths() {
  return (await getCollection('fases')).map((f) => ({ params: { id: String(f.id) } }));
}

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const fase = (await getEntry('fases', Astro.params.id!))!;
const d = fase.data;
const [dicas, prev, next, niveis] = await Promise.all([
  dicasDaFase(d.id),
  getEntry('fases', String(d.id - 1)),
  getEntry('fases', String(d.id + 1)),
  Promise.all(d.niveis.map((n) => getEntry('niveis', String(n)))),
]);
const ids = dicas.map(idProgresso);
const rotulo = (f: NonNullable<typeof prev>) => `Fase ${f.data.id} · ${cap(f.data.nome)}`;
---
<Base titulo={`Fase ${d.id} · ${cap(d.nome)} | Roadmap AI Engineer`} descricao={d.objetivo} rotaOg={`fase/${d.id}`}>
  <div class="detail">
    <Migalha itens={[{ rotulo: 'Mapa', href: url('/') }, { rotulo: 'Carreira' }, { rotulo: `Fase ${d.id}` }]} />
    <header class="pg-cab">
      <div class="pg-cab-txt">
        <div class="pg-meta">
          <span class="etq">Carreira · fase {d.id} de 5</span>
          <span class="dur">{d.quando} · {ids.length} dicas</span>
        </div>
        <h1>{cap(d.nome)}</h1>
        <p class="obj">{d.objetivo}</p>
        <div class="lp" data-progresso-conta={ids.join(',')}>
          <div class="track" role="progressbar" aria-label="Progresso da fase" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span data-progresso-barra></span>
          </div>
          <small data-progresso-texto>0 / {ids.length}</small>
        </div>
      </div>
      <div class="pg-lado" aria-hidden="true"><div class="pg-num">{String(d.id).padStart(2, '0')}<small>fase de 05</small></div></div>
    </header>

    <div class="pg-grade">
      <div class="cols">
        <div class="kicker">01 — Dicas</div>
        <section class="grupo">
          <h2>O que fazer nesta fase</h2>
          <div class="linhas">{dicas.map((x) => <LinhaTopico entry={x} />)}</div>
        </section>
      </div>

      <aside class="cross" aria-labelledby="no-estudo">
        {niveis.length > 0 ? (
          <>
            <h2 id="no-estudo">No estudo, no mesmo período</h2>
            <ul class="niv-links">
              {niveis.map((n) => n && (
                <li>
                  <a href={url(`/nivel/${n.data.id}/`)}>
                    <span><span class="k">{n.data.duracao}</span>Nível {n.data.id} · {cap(n.data.curto)}</span>
                    <ArrowRight aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2 id="no-estudo">No estudo, nesta fase</h2>
            <p class="sub">Aprofundar onde você quer ser sênior: design de sistemas com LLM, custo e segurança em escala.</p>
          </>
        )}
      </aside>
    </div>

    <section class="pg-sec">
      <div class="kicker">02 — Critérios</div>
      <h2>Como saber que terminou</h2>
      <ol class="crit-lista">{d.criterios.map((c, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{c}</span></li>)}</ol>
    </section>

    <AnteriorProximo
      anterior={prev && { rotulo: rotulo(prev), href: url(`/fase/${prev.data.id}/`) }}
      proximo={next && { rotulo: rotulo(next), href: url(`/fase/${next.data.id}/`) }}
    />
  </div>
</Base>
