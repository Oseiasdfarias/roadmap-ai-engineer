---
import { getCollection, getEntry } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Ilustracao from '../../components/Ilustracao.astro';
import Migalha from '../../components/Migalha.astro';
import LinhaTopico from '../../components/LinhaTopico.astro';
import AnteriorProximo from '../../components/AnteriorProximo.astro';
import { dicasDaFase, idProgresso, projetosDoNivel, rotaDe, topicosDoNivel } from '../../lib/conteudo';
import { url } from '../../lib/url';
import '../../styles/detalhe.css';

export async function getStaticPaths() {
  return (await getCollection('niveis')).map((n) => ({ params: { id: String(n.id) } }));
}

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const nivel = (await getEntry('niveis', Astro.params.id!))!;
const d = nivel.data;
const [grupos, projetos, fase, prev, next] = await Promise.all([
  topicosDoNivel(d.id),
  projetosDoNivel(d.id),
  getEntry('fases', String(d.fase)),
  getEntry('niveis', String(d.id - 1)),
  getEntry('niveis', String(d.id + 1)),
]);
const dicas = await dicasDaFase(d.fase);
const ids = grupos.flatMap((g) => g.itens).map(idProgresso);
const rotulo = (n: NonNullable<typeof prev>) => `Nível ${n.data.id} · ${cap(n.data.curto)}`;
const semCodigo = (t: string) => t.replace(/^[A-Z0-9]+:\s*/, '');
const rotuloProjeto = (p: (typeof projetos)[number]) => {
  const c = p.data.camadas ?? [];
  return c.length > 1 ? `${p.data.codigo} · ${c[0].versao} a ${c[c.length - 1].versao}` : p.data.codigo;
};
const secCrit = projetos.length > 0 ? '03' : '02';
---
<Base titulo={`Nível ${d.id} · ${cap(d.nome)} | Roadmap AI Engineer`} descricao={d.objetivo} rotaOg={`nivel/${d.id}`}>
  <div class="detail">
    <Migalha itens={[{ rotulo: 'Mapa', href: url('/') }, { rotulo: 'Estudo' }, { rotulo: `Nível ${d.id}` }]} />
    <header class="pg-cab">
      <div class="pg-cab-txt">
        <div class="pg-meta">
          <span class="etq">Nível {d.id} · <span data-perfil-duracao={d.id}>{d.duracao}</span></span>
          <span class="dur">Nível {d.id} de 4 · {ids.length} tópicos</span>
        </div>
        <h1>{cap(d.nome)}</h1>
        <p class="obj">{d.objetivo}</p>
        <div class="lp" data-progresso-conta={ids.join(',')}>
          <div class="track" role="progressbar" aria-label="Progresso do nível" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span data-progresso-barra></span>
          </div>
          <small data-progresso-texto>0 / {ids.length}</small>
        </div>
      </div>
      <div class="pg-lado"><Ilustracao nome={`nivel${d.id}`} /></div>
    </header>

    <div class="pg-grade">
      <div class="cols">
        <div class="kicker">01 — Tópicos</div>
        {grupos.map((g) => (
          <section class="grupo">
            <h2>{g.grupo}</h2>
            <div class="linhas">{g.itens.map((t) => <LinhaTopico entry={t} />)}</div>
          </section>
        ))}
      </div>

      {fase && (
        <aside class="cross" aria-labelledby="na-carreira">
          <h2 id="na-carreira"><span class="rot">Ao mesmo tempo, na carreira</span><span class="fase-t">Fase {fase.data.id} · {cap(fase.data.nome)}</span></h2>
          <p class="sub">{fase.data.objetivo}</p>
          <div class="linhas">{dicas.map((x) => <LinhaTopico entry={x} />)}</div>
          <a class="abrir" href={url(`/fase/${fase.data.id}/`)}>Abrir a fase {fase.data.id} <ArrowRight aria-hidden="true" /></a>
        </aside>
      )}
    </div>

    {projetos.length > 0 && (
      <section class="pg-sec">
        <div class="kicker">02 — Portfólio</div>
        <h2>Projetos práticos</h2>
        <div class="projs">
          {projetos.map((p) => (
            <a href={rotaDe(p)}><span class="k">{rotuloProjeto(p)}</span><span class="t">{semCodigo(p.data.titulo)}</span><span class="d">{p.data.resumo}</span></a>
          ))}
        </div>
      </section>
    )}

    <section class="pg-sec">
      <div class="kicker">{secCrit} — Critérios</div>
      <h2>Como saber que terminou</h2>
      <ol class="crit-lista">{d.criterios.map((c, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{c}</span></li>)}</ol>
    </section>

    <AnteriorProximo
      anterior={prev && { rotulo: rotulo(prev), href: url(`/nivel/${prev.data.id}/`) }}
      proximo={next && { rotulo: rotulo(next), href: url(`/nivel/${next.data.id}/`) }}
    />
  </div>
</Base>
