---
import { getCollection, getEntry } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Ilustracao from '../../components/Ilustracao.astro';
import Migalha from '../../components/Migalha.astro';
import LinhaTopico from '../../components/LinhaTopico.astro';
import AnteriorProximo from '../../components/AnteriorProximo.astro';
import { dicasDaFase, idProgresso, projetosDoNivel, rotaDe, topicosDoNivel } from '../../lib/conteudo';
import { url } from '../../lib/url';
import '../../styles/detalhe.css';

export async function getStaticPaths() {
  return (await getCollection('niveis')).map((n) => ({ params: { id: String(n.id) } }));
}

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const nivel = (await getEntry('niveis', Astro.params.id!))!;
const d = nivel.data;
const [grupos, projetos, fase, prev, next] = await Promise.all([
  topicosDoNivel(d.id),
  projetosDoNivel(d.id),
  getEntry('fases', String(d.fase)),
  getEntry('niveis', String(d.id - 1)),
  getEntry('niveis', String(d.id + 1)),
]);
const dicas = await dicasDaFase(d.fase);
const ids = grupos.flatMap((g) => g.itens).map(idProgresso);
const rotulo = (n: NonNullable<typeof prev>) => `Nível ${n.data.id} · ${cap(n.data.curto)}`;
---
<Base titulo={`Nível ${d.id} · ${cap(d.nome)} | Roadmap AI Engineer`} descricao={d.objetivo} rotaOg={`nivel/${d.id}`}>
  <div class="detail">
    <Migalha itens={[{ rotulo: 'Mapa', href: url('/') }, { rotulo: 'Estudo' }, { rotulo: `Nível ${d.id}` }]} />
    <div class="panel">
      <div class="ph">
        <div>
          <div class="kick">Nível {d.id} de 4 · {d.duracao}</div>
          <h1>{cap(d.nome)}</h1>
          <p>{d.objetivo}</p>
          <div class="lp" data-progresso-conta={ids.join(',')} data-progresso-formato="de">
            <div class="track" role="progressbar" aria-label="Progresso do nível" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <span data-progresso-barra></span>
            </div>
            <small data-progresso-texto>0 de {ids.length}</small>
          </div>
        </div>
        <div><Ilustracao nome={`nivel${d.id}`} /></div>
      </div>

      <div class="cols">
        {grupos.map((g) => (
          <section>
            <h2>{g.grupo}</h2>
            {g.itens.map((t) => <LinhaTopico entry={t} />)}
          </section>
        ))}
      </div>

      {projetos.length > 0 && (
        <>
          <h2 class="sub-h">Projetos práticos</h2>
          <div class="projs">
            {projetos.map((p) => (
              <a href={rotaDe(p)}><b>{p.data.titulo}</b><span>{p.data.resumo}</span></a>
            ))}
          </div>
        </>
      )}

      {fase && (
        <section class="cross">
          <h2>Ao mesmo tempo, na carreira: fase {fase.data.id} · {cap(fase.data.nome)}</h2>
          <p class="sub">
            {fase.data.objetivo}
            <a class="lk" href={url(`/fase/${fase.data.id}/`)}>Abrir a fase <ArrowRight aria-hidden="true" /></a>
          </p>
          {dicas.map((x) => <LinhaTopico entry={x} />)}
        </section>
      )}

      <section class="crit">
        <h2 class="sub-h">Como saber que terminou</h2>
        <ul>{d.criterios.map((c) => <li>{c}</li>)}</ul>
      </section>
    </div>
    <AnteriorProximo
      anterior={prev && { rotulo: rotulo(prev), href: url(`/nivel/${prev.data.id}/`) }}
      proximo={next && { rotulo: rotulo(next), href: url(`/nivel/${next.data.id}/`) }}
    />
  </div>
</Base>
