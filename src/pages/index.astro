---
import Base from '../layouts/Base.astro';
import Hero from '../components/inicio/Hero.astro';
import Escolha from '../components/inicio/Escolha.astro';
import Tempo from '../components/inicio/Tempo.astro';
import Niveis from '../components/inicio/Niveis.astro';
import Portfolio from '../components/inicio/Portfolio.astro';
import Carreira from '../components/inicio/Carreira.astro';
import Painel from '../components/Painel.astro';
import { SITE } from '../config';
---
<Base titulo={SITE.titulo} descricao={SITE.descricao} rotaOg="index">
  <Hero />
  <Escolha />
  <Tempo />
  <Niveis />
  <Portfolio />
  <Carreira />
  <Painel />
</Base>
<script>
  import '../scripts/inicio';
  import '../scripts/escolha';
</script>
