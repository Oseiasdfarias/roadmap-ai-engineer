---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base titulo="Página não encontrada | Roadmap AI Engineer" descricao="Essa página não existe. Volte ao mapa do roadmap." noindex>
  <section class="nf">
    <div class="nf-grade" aria-hidden="true"></div>
    <div class="nf-in">
      <div class="nf-num" aria-hidden="true">404</div>
      <div class="kicker">Erro 404</div>
      <h1>Página não encontrada</h1>
      <p>O endereço não existe ou mudou de lugar.</p>
      <div class="nf-bt">
        <a class="nf-pri" href={url('/')}>Voltar ao mapa</a>
        <a class="nf-sec" href={url('/nivel/1/')}>Abrir o nível 1</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; overflow: hidden; }
  .nf-grade { position: absolute; inset: 0; background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 56px 56px; opacity: .7; -webkit-mask-image: linear-gradient(#000 50%, transparent); mask-image: linear-gradient(#000 50%, transparent); }
  .nf-in { position: relative; max-width: 760px; margin: 0 auto; padding: 96px 16px 120px; text-align: center; }
  .nf-num { font-weight: 700; font-size: clamp(110px, 24vw, 240px); line-height: .82; letter-spacing: -.07em; color: transparent; -webkit-text-stroke: 1.5px var(--outline-text); margin-bottom: 40px; user-select: none; }
  h1 { font-size: clamp(32px, 5vw, 52px); font-weight: 600; letter-spacing: -.04em; line-height: 1.05; margin: 0; }
  p { font-size: 17px; line-height: 1.6; color: var(--text-2); margin: 16px 0 0; }
  .nf-bt { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 32px; }
  .nf-pri, .nf-sec { text-decoration: none; border-radius: 10px; font-size: 15px; display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; }
  .nf-pri { background: var(--btn-bg); color: var(--btn-ink); font-weight: 600; }
  .nf-sec { border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--text); font-weight: 500; }
  .nf-pri:hover { opacity: .9; }
  .nf-sec:hover { border-color: var(--accent); }
</style>
