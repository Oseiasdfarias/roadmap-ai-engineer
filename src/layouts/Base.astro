---
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  descricao: string;
  rotaOg?: string;
  semCabecalho?: boolean;
}
const { titulo, descricao, rotaOg, semCabecalho = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imagemOg = rotaOg ? new URL(url('/og/' + rotaOg + '.png'), SITE.url).href : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.titulo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    {imagemOg && <meta property="og:image" content={imagemOg} />}
    <meta name="twitter:card" content={imagemOg ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('rm-tema'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    {!semCabecalho && <Header />}
    <main><slot /></main>
    <Footer />
  </body>
</html>
