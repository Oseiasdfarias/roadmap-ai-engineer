---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/fluxo.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Busca from '../components/Busca.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
import { todosIdsProgresso } from '../lib/conteudo';
import { dadosTrilha } from '../lib/dados-trilha';
import { equivalentes, idiomaDaUrl } from '../i18n/idioma';

interface Props {
  titulo: string;
  descricao: string;
  rotaOg?: string;
  semCabecalho?: boolean;
  /** Página interna: sem indexação por buscadores nem pelo Pagefind. */
  noindex?: boolean;
}
const { titulo, descricao, rotaOg, semCabecalho = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const lang = idiomaDaUrl(Astro.url.pathname);
const alternativas = equivalentes(Astro.url.pathname);
const idsProgresso = await todosIdsProgresso();
const trilha = await dadosTrilha(lang);
const trilhaBase = {
  topicos: trilha.topicos.map(({ id, nivel, tempo }) => ({ id, nivel, tempo, prerequisitos: [] })),
  niveis: trilha.niveis.map(({ nivel, duracao, curto, fase }) => ({ nivel, duracao, curto, fase })),
};
const imagemOg = rotaOg ? new URL(url('/og/' + (lang === 'en' ? 'en/' : '') + rotaOg + '.png'), SITE.url).href : undefined;
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(alternativas.pt, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternativas.en, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternativas.pt, SITE.url).href} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.titulo} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pt_BR'} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    {imagemOg && <meta property="og:image" content={imagemOg} />}
    <meta name="twitter:card" content={imagemOg ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('rm-tema'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body data-base-url={url('/')} data-idioma={lang}>
    {!semCabecalho && <Header />}
    <main data-pagefind-body={noindex ? undefined : ''} data-pagefind-ignore={noindex ? '' : undefined}><slot /></main>
    <Footer />
    <Busca />
    <script type="application/json" data-trilha-base set:html={JSON.stringify(trilhaBase)} />
    <script type="application/json" data-progresso-todos set:html={JSON.stringify(idsProgresso)} />
    <script>
      import '../scripts/progresso';
      import '../scripts/cabecalho';
      import '../scripts/perfil-site';
      import '../scripts/fluxo';
    </script>
  </body>
</html>
