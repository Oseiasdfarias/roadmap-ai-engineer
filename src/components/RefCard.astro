---
import { ArrowUpRight } from '@lucide/astro';
import capas from '../data/capas.json';
import { idiomaDaUrl } from '../i18n/idioma';

const TIPOS_EN: Record<string, string> = { Vídeo: 'Video', Curso: 'Course', Docs: 'Docs', Artigo: 'Article', Repositório: 'Repository', Vagas: 'Jobs', Livro: 'Book' };

interface Props {
  ref: { titulo: string; url: string; tipo: string };
  /** Sobrescreve a capa de src/data/capas.json (uso em testes). */
  capa?: string;
}
const { ref: r, capa } = Astro.props;
const info = (capas as Record<string, { tipo: string; dominio: string; icone: string; img: string | null }>)[r.url];
const dominio = info?.dominio ?? new URL(r.url).host.replace(/^www\./, '');
const icone = info?.icone ?? `https://www.google.com/s2/favicons?sz=64&domain=${new URL(r.url).host}`;
const img = capa ?? info?.img ?? null;
const tipo = idiomaDaUrl(Astro.url.pathname) === 'en' ? (TIPOS_EN[r.tipo] ?? r.tipo) : r.tipo;
---
<a class="ref" href={r.url} target="_blank" rel="noopener noreferrer">
  <span class="th" data-ico={icone}>
    {img
      ? <img class="capa" src={img} alt="" loading="lazy" referrerpolicy="no-referrer" />
      : <img class="ico" src={icone} alt="" loading="lazy" referrerpolicy="no-referrer" />}
  </span>
  <span class="corpo">
    <span class="ref-tit">{r.titulo}</span>
    <span class="mt">
      <span class="tg">{tipo}</span>
      <span class="dom">{dominio}</span>
      <span class="ar"><ArrowUpRight size={15} aria-hidden="true" /></span>
    </span>
  </span>
</a>

<script>
  // Se a capa não carrega, troca pelo ícone do site. Um único ouvinte delegado (error não borbulha: captura).
  function trocar(img: HTMLImageElement) {
    const th = img.parentElement as HTMLElement | null;
    if (!th || !th.dataset.ico) return;
    const ico = document.createElement('img');
    ico.className = 'ico';
    ico.alt = '';
    ico.src = th.dataset.ico;
    ico.loading = 'lazy';
    ico.referrerPolicy = 'no-referrer';
    img.replaceWith(ico);
  }
  document.addEventListener(
    'error',
    (e) => {
      const alvo = e.target;
      if (alvo instanceof HTMLImageElement && alvo.classList.contains('capa')) trocar(alvo);
    },
    true,
  );
  // Capas que já falharam antes de este script rodar.
  document.querySelectorAll<HTMLImageElement>('img.capa').forEach((img) => {
    if (img.complete && img.naturalWidth === 0) trocar(img);
  });
</script>

<style>
  .ref {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 8px;
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    transition: border-color 0.15s, transform 0.15s;
  }
  .ref:hover { border-color: var(--accent); }
  .th {
    width: 128px;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-2);
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
  }
  .th :global(img.capa) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .th :global(img.ico) { width: 26px; height: 26px; border-radius: 6px; }
  .corpo { min-width: 0; padding-right: 4px; }
  .ref-tit { font-size: 14px; font-weight: 500; line-height: 1.4; display: block; color: var(--text); }
  .mt { display: flex; align-items: center; gap: 10px; margin-top: 7px; font-size: 12px; color: var(--muted); min-width: 0; }
  .tg { font-family: var(--font-mono); font-size: 11px; color: var(--accent); border: 1px solid var(--accent-border); background: var(--accent-soft); border-radius: 5px; padding: 1px 6px; flex: none; }
  .dom { font-family: var(--font-mono); font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .ar { margin-left: auto; padding-right: 4px; display: inline-flex; color: var(--muted); flex: none; }
  .ref:hover .ar { color: var(--accent); }
  @media (max-width: 420px) {
    .ref { grid-template-columns: 96px minmax(0, 1fr); gap: 12px; }
    .th { width: 96px; }
  }
  @media (prefers-reduced-motion: reduce) { .ref { transition: none; } .ref:hover { transform: none; } }
</style>
