---
import { Search, X } from '@lucide/astro';
import { url } from '../lib/url';
---
<dialog id="busca" class="busca" aria-label="Buscar" data-pagefind-ignore data-pagefind-js={url('/pagefind/pagefind.js')}>
  <div class="busca-caixa">
    <form class="busca-campo" role="search" onsubmit="return false">
      <Search aria-hidden="true" />
      <input type="search" role="searchbox" name="q" placeholder="Buscar tópicos, projetos e dicas" aria-label="Buscar no roadmap" autocomplete="off" spellcheck="false" />
      <button type="button" class="btn icon-btn" data-busca-fechar aria-label="Fechar a busca"><X aria-hidden="true" /></button>
    </form>
    <div class="busca-estado" role="status" aria-live="polite" data-busca-estado>Digite para buscar. Atalhos: / ou Ctrl+K.</div>
    <ul class="busca-lista" data-busca-lista></ul>
  </div>
</dialog>
<script>
  import { ligarBusca } from '../scripts/busca';
  ligarBusca();
</script>

<style is:global>
  .busca { border: 1px solid var(--line-strong); border-radius: 20px; background: var(--surface); color: var(--text); padding: 0; width: min(660px, calc(100vw - 32px)); max-height: min(580px, calc(100vh - 80px)); margin: 10vh auto auto; box-shadow: 0 24px 60px rgba(0, 0, 0, .28); overflow: hidden; }
  .busca::backdrop { background: rgba(8, 12, 18, .6); backdrop-filter: blur(3px); }
  .busca-caixa { display: flex; flex-direction: column; max-height: inherit; }
  .busca-campo { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 20px; border-bottom: 1px solid var(--line); margin: 0; }
  .busca-campo > svg { width: 18px; height: 18px; color: var(--muted); flex: none; }
  .busca-campo input { flex: 1; min-width: 0; min-height: 44px; border: 0; background: transparent; color: var(--text); font: inherit; font-size: 17px; outline: none; }
  .busca-campo input::placeholder { color: var(--muted); }
  .busca-campo input:focus-visible { outline: none; }
  .busca-campo:focus-within { box-shadow: inset 0 -2px 0 var(--accent); }
  .busca-estado { padding: 12px 20px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .busca-lista { list-style: none; margin: 0; padding: 0 10px 12px; overflow-y: auto; }
  .busca-lista li + li { margin-top: 2px; }
  .busca-lista a { display: block; padding: 12px 12px; border-radius: 12px; border: 1px solid transparent; color: var(--text); text-decoration: none; }
  .busca-lista a:hover { background: var(--surface-2); border-color: var(--line); }
  .busca-lista a:focus-visible { background: var(--surface-2); border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: -2px; }
  .busca-lista strong { display: block; font-size: 15px; font-weight: 600; letter-spacing: -.01em; }
  .busca-lista span { display: block; font-size: 13.5px; line-height: 1.5; color: var(--text-2); margin-top: 3px; }
  .busca-lista mark { background: var(--accent-soft); color: var(--accent); border-radius: 3px; padding: 0 2px; }
  @media (prefers-reduced-motion: reduce) { .busca * { transition: none !important; } }
</style>
