---
import { getEntry } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import { BARRAS_FASE, BARRAS_NIVEL, MESES, PASSO_REGUA } from '../../data/linha-do-tempo';
import { projetosDoNivel } from '../../lib/conteudo';
import { url } from '../../lib/url';

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const barras = await Promise.all(
  BARRAS_NIVEL.map(async (b) => {
    const nivel = (await getEntry('niveis', String(b.nivel)))!.data;
    const projetos = (await projetosDoNivel(b.nivel)).map((p) => p.data.codigo);
    const extra = projetos.length > 1 ? ` · ${projetos[0]} a ${projetos[projetos.length - 1]}` : projetos.length === 1 ? ` · ${projetos[0]}` : '';
    return { ...b, rotulo: `0${b.nivel} ${cap(nivel.curto)}${extra}`, href: url(`/nivel/${b.nivel}/`) };
  }),
);
const meses = Array.from({ length: MESES }, (_, i) => i);
const col = (inicio: number, fim: number) => `grid-column: ${inicio + 2} / ${fim + 2}`;
---
<section id="tempo" class="sec-alt rv">
  <div class="sec-in">
    <div class="sec-cab">
      <div>
        <div class="kicker">01 — Linha do tempo</div>
        <h2 data-perfil-tl-titulo>Meses, com 10 a 15 horas por semana.</h2>
        <p class="tl-aviso" data-perfil-aviso hidden>Ajustado ao seu perfil · <a href={url('/calculadora/')}>alterar</a></p>
      </div>
      <p>Os níveis se sobrepõem e a carreira corre por baixo deles. <span data-perfil-generico>Esta é a referência para quem começa do zero. <a class="tl-calc" href={url('/calculadora/')}>Seu ponto de partida é outro? Calcule sua trilha <ArrowRight aria-hidden="true" /></a></span></p>
    </div>
    <div class="tl-caixa" tabindex="0" role="region" aria-label="Linha do tempo em meses (role para ver tudo)">
      <div class="tl" data-perfil-tl>
        <div class="tl-reg" aria-hidden="true">
          <span>mês</span>
          {meses.map((m) => <span>{m % PASSO_REGUA === 0 ? m : ''}</span>)}
        </div>
        <ul class="tl-lista">
          {barras.map((b, i) => (
            <li class="tl-linha">
              <span class="tl-rot">{i === 0 ? 'Estudo' : ''}</span>
              <a class={`tl-barra n${b.nivel}`} data-nivel={b.nivel} style={col(b.inicio, b.fim)} href={b.href}>{b.rotulo}</a>
            </li>
          ))}
        </ul>
        <ul class="tl-lista tl-carreira">
          <li class="tl-linha">
            <span class="tl-rot acc">Carreira</span>
            {BARRAS_FASE.map((f) => (
              <a class={`tl-fase f${f.fase}`} data-fase={f.fase} style={col(f.inicio, f.fim)} href={url(`/fase/${f.fase}/`)}>{f.fase} {f.rotulo}</a>
            ))}
            <a class="tl-fase tl-perfil" data-perfil-tl-carreira hidden href={url('/calculadora/')}></a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .sec-alt { border-top: 1px solid var(--line); background: var(--section-alt); }
  .sec-in { max-width: 1240px; margin: 0 auto; padding: 96px 32px; }
  .sec-cab { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; margin-bottom: 44px; }
  .sec-cab h2 { font-size: clamp(30px, 4vw, 44px); font-weight: 600; letter-spacing: -.04em; line-height: 1.05; margin: 0; max-width: 700px; text-wrap: balance; }
  .sec-cab > p { font-size: 15px; line-height: 1.6; color: var(--text-2); max-width: 380px; margin: 0; }
  .tl-calc { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; color: var(--accent); font-weight: 500; text-decoration: none; }
  .tl-calc:hover { text-decoration: underline; }
  .tl-calc svg { width: 14px; height: 14px; }
  .tl-caixa { border: 1px solid var(--line); border-radius: 20px; background: var(--surface); padding: 28px 28px 24px; overflow-x: auto; }
  .tl { min-width: 860px; }
  .tl-reg, .tl-linha { display: grid; grid-template-columns: 120px repeat(var(--tl-meses, 24), minmax(0, 1fr)); align-items: center; }
  .tl-reg { font-family: var(--font-mono); font-size: 11px; color: var(--muted); padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 14px; }
  .tl-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .tl-rot { font-size: 13px; font-weight: 600; color: var(--link); }
  .tl-rot.acc { color: var(--accent); }
  .tl-barra { border-radius: 8px; padding: 11px 14px; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: transform .2s, filter .2s; }
  .tl-barra.n1 { background: var(--tl-1); color: var(--tl-1-ink); }
  .tl-barra.n2 { background: var(--tl-2); color: var(--tl-2-ink); }
  .tl-barra.n3 { background: var(--tl-3); color: var(--tl-3-ink); }
  .tl-barra.n4 { background: var(--tl-4); color: var(--tl-4-ink); border: 1px solid var(--tl-4-line); padding: 10px 13px; }
  .tl-barra:hover { transform: translateY(-2px); filter: brightness(1.08); }
  .tl-aviso { font-family: var(--font-mono); font-size: 12px; color: var(--accent); margin: 12px 0 0; }
  .tl-aviso[hidden], .tl-fase[hidden], .sec-cab [data-perfil-generico][hidden] { display: none; }
  .tl-aviso a { color: inherit; }
  .tl-fase.tl-perfil { border-radius: 8px; background: var(--accent-soft); }
  .tl-carreira { margin-top: 14px; padding-top: 16px; border-top: 1px dashed var(--line-strong); }
  .tl-fase { border: 1px solid var(--career-line); color: var(--career-ink); padding: 10px 13px; font-size: 13px; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: background .2s; }
  .tl-fase:hover { background: var(--accent-soft); }
  .tl-fase.f1 { border-radius: 8px 0 0 8px; }
  .tl-fase.f2 { border-left: 0; background: var(--accent-soft); }
  .tl-fase.f3 { border-left: 0; border-radius: 0 8px 8px 0; }
  @media (max-width: 760px) {
    .sec-in { padding: 64px 16px; }
    .sec-cab { margin-bottom: 28px; gap: 16px; }
    .tl-caixa { padding: 20px 16px 18px; border-radius: 16px; }
  }
</style>
