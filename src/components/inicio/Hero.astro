---
import { getCollection, getEntry } from 'astro:content';
import { Download, Flag } from '@lucide/astro';
import { PERIODOS } from '../../data/periodos';
import { PDF_URL } from '../../config';
import { dicasDaFase, idProgresso, topicosDoNivel } from '../../lib/conteudo';
import { url } from '../../lib/url';

const estacoes = await Promise.all(
  PERIODOS.map(async (p, i) => {
    const ids = [
      ...(p.nivel ? (await topicosDoNivel(p.nivel)).flatMap((g) => g.itens.map(idProgresso)) : []),
      ...(p.fase ? (await dicasDaFase(p.fase)).map(idProgresso) : []),
    ];
    const href = p.nivel ? url(`/nivel/${p.nivel}/`) : url(`/fase/${p.fase ?? p.faseLink}/`);
    return { p, n: String(i + 1).padStart(2, '0'), ids, href };
  }),
);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const [colNiveis, colFases, colProjetos] = await Promise.all([getCollection('niveis'), getCollection('fases'), getCollection('projetos')]);
// Rota da abertura: Python -> os quatro níveis -> agente em produção.
const rota = await Promise.all(
  colNiveis
    .sort((a, b) => a.data.id - b.data.id)
    .map(async (n) => ({
      id: n.data.id,
      nome: cap((await getEntry('niveis', String(n.data.id)))!.data.curto),
      ids: (await topicosDoNivel(n.data.id)).flatMap((g) => g.itens.map(idProgresso)),
    })),
);
const numeros = [
  { n: colNiveis.length, rotulo: 'níveis', href: '#niveis' },
  { n: colFases.length, rotulo: 'fases de carreira', href: '#carreira' },
  { n: colProjetos.length, rotulo: 'projetos', href: '#portfolio' },
];
---
<section class="hero">
  <div class="hero-grade" aria-hidden="true"></div>
  <div class="hero-in" data-hero-abertura>
    <div class="hero-marca" aria-hidden="true">RAI<span>.</span>E</div>
    <div class="hero-pilula"><i></i>Estudo e carreira, lado a lado</div>
    <h1>Roadmap AI Engineer</h1>
    <p class="hero-sub">Do primeiro script em Python <span>a um agente em produção.</span></p>
    <nav class="rota" aria-label="Rota do roadmap">
      <div class="rota-rolo">
        <ol class="rota-lista" style="--rp: 0.2" data-rota>
          <li class="rota-trilho" aria-hidden="true"><i></i></li>
          <li class="rota-no rota-ini"><span class="n" aria-hidden="true"></span><span class="pt" aria-hidden="true"></span><span class="rot">Python</span></li>
          {rota.map((r, i) => (
            <li class:list={['rota-no', 'nivel', { atual: i === 0 }]} data-rota-nivel={r.id} data-ids={r.ids.join(',')}>
              <a href={url(`/nivel/${r.id}/`)}>
                <span class="n" aria-hidden="true">{String(r.id).padStart(2, '0')}</span>
                <span class="pt" aria-hidden="true"></span>
                <span class="rot"><span class="sr-only">Nível {r.id}: </span>{r.nome}</span>
              </a>
            </li>
          ))}
          <li class="rota-no rota-fim"><span class="n" aria-hidden="true"></span><span class="pt" aria-hidden="true"><Flag /></span><span class="rot">Agente em produção</span></li>
        </ol>
      </div>
    </nav>
    <ul class="hero-numeros">
      {numeros.map((x) => <li><a href={x.href}><b>{x.n}</b> {x.rotulo}</a></li>)}
    </ul>
    <p class="hero-nota">Cada tópico tem um resumo completo e as fontes certas para estudar.</p>
    <div class="hero-ctas">
      <a class="bt-pri" data-perfil-cta href={url('/nivel/1/')}>Começar pelo nível 1</a>
      <a class="bt-sec" href="#escolha">Ajustar ao meu perfil</a>
      {PDF_URL && <a class="bt-sec" href={PDF_URL}><Download aria-hidden="true" />Baixar o PDF</a>}
    </div>
  </div>
  <nav class="periodos" aria-label="Períodos" data-periodos>
    <ol class="estacoes" style="--p: 0">
      <li class="trilho" aria-hidden="true"><i></i></li>
      {estacoes.map((e, i) => (
        <li data-periodo data-estacao={i} data-ids={e.ids.join(',')} class:list={['est', { atual: i === 0, proxima: i === 1 }]}>
          <a href={e.href}>
            <span class="num">{e.n}</span>
            <span class="nome" data-periodo-nome={e.p.nivel ?? 0}>{e.p.nome}</span>
            <span class="sub">{e.p.sub}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</section>

<style is:global>
  .bt-pri, .bt-sec { text-decoration: none; border-radius: 10px; font-size: 15px; display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; transition: transform .2s, border-color .2s, opacity .2s; }
  .bt-pri { background: var(--btn-bg); color: var(--btn-ink); font-weight: 600; }
  .bt-sec { border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--text); font-weight: 500; }
  .bt-sec svg { width: 15px; height: 15px; }
  .bt-sec:hover { border-color: var(--accent); }
  .hero { position: relative; overflow: hidden; }
  .hero-grade { position: absolute; inset: 0; background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 56px 56px; opacity: .7; -webkit-mask-image: linear-gradient(#000 55%, transparent); mask-image: linear-gradient(#000 55%, transparent); }
  /* A abertura ocupa a altura visível abaixo do cabeçalho; os tamanhos escalam com a altura (svh) para caber em telas baixas. */
  .hero-in {
    position: relative; max-width: 1240px; margin: 0 auto; text-align: center;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    padding: clamp(20px, 5svh, 80px) 32px;
  }
  .hero-marca { font-weight: 700; font-size: clamp(44px, min(13vw, 16svh), 168px); line-height: .82; letter-spacing: -.07em; color: transparent; -webkit-text-stroke: 1.5px var(--outline-text); margin: 0 auto clamp(12px, 3.5svh, 36px); white-space: nowrap; user-select: none; pointer-events: none; }
  .hero-marca span { -webkit-text-stroke-color: var(--accent); }
  .hero-pilula { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line-strong); background: var(--surface-2); border-radius: 999px; padding: 6px 14px; font-size: 13px; color: var(--text-2); }
  .hero-pilula i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .hero h1 { font-weight: 600; font-size: clamp(40px, min(6.2vw, 9svh), 84px); line-height: 1; letter-spacing: -.045em; margin: clamp(12px, 2.6svh, 26px) auto 0; max-width: 1100px; text-wrap: balance; }
  .hero-sub { font-size: clamp(19px, min(2.6vw, 3.6svh), 32px); font-weight: 500; line-height: 1.2; letter-spacing: -.025em; color: var(--text); margin: clamp(8px, 1.6svh, 16px) auto 0; max-width: 900px; text-wrap: balance; }
  .hero-sub span { color: var(--muted); }

  /* rota: Python -> níveis -> agente */
  .rota { width: 100%; max-width: 860px; margin: clamp(16px, 3.6svh, 40px) auto 0; }
  .rota-lista { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .rota-trilho { position: absolute; left: calc(100% / 12); right: calc(100% / 12); top: calc(var(--rn) + 7px); height: 2px; background: var(--line-strong); transform-origin: left; animation: rota-desenha .9s ease .15s both; }
  .rota-trilho i { display: block; height: 100%; width: calc(var(--rp) * 100%); background: var(--accent); transition: width .5s ease; }
  @keyframes rota-desenha { from { transform: scaleX(0); } to { transform: none; } }
  .rota-lista { --rn: 22px; }
  .rota-no, .rota-no a { display: flex; flex-direction: column; align-items: center; gap: 0; text-align: center; color: var(--text); text-decoration: none; position: relative; }
  .rota-no a { border-radius: 8px; padding: 0 4px 4px; }
  .rota-no .n { height: var(--rn); font-family: var(--font-mono); font-size: 11px; color: var(--muted); line-height: 1; padding-top: 2px; }
  .rota-no .pt { width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--check-off); display: grid; place-items: center; transition: transform .2s, border-color .2s, background .2s; }
  .rota-no .rot { margin-top: 10px; font-size: 14px; font-weight: 500; line-height: 1.25; }
  .rota-no.rota-ini .pt { background: var(--accent); border-color: var(--accent); }
  .rota-no.rota-ini .rot, .rota-no.rota-fim .rot { color: var(--text-2); }
  .rota-no.rota-fim .pt { width: 24px; height: 24px; margin-top: -4px; margin-bottom: -4px; border-color: var(--accent); color: var(--accent); }
  .rota-no.rota-fim .pt svg { width: 12px; height: 12px; }
  .rota-no.nivel.atual .pt { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .rota-no.nivel.completo .pt { background: var(--accent); border-color: var(--accent); }
  .rota-no.nivel.completo .n, .rota-no.nivel.atual .n { color: var(--accent); }
  .rota-no a:hover .pt { border-color: var(--accent); transform: scale(1.15); }
  .rota-no a:hover .rot { color: var(--accent); }

  .hero-numeros { list-style: none; margin: clamp(16px, 3.4svh, 36px) auto 0; padding: 0; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .hero-numeros a { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 12px; font-size: 13px; color: var(--text-2); text-decoration: none; background: var(--surface); transition: border-color .2s; }
  .hero-numeros a:hover { border-color: var(--accent); color: var(--text); }
  .hero-numeros b { font-family: var(--font-mono); font-weight: 500; font-size: 14px; color: var(--accent); }
  .hero-nota { font-size: clamp(14px, 2.1svh, 16px); line-height: 1.55; color: var(--text-2); max-width: 640px; margin: clamp(10px, 1.8svh, 16px) auto 0; }
  .hero-ctas { display: flex; gap: 12px; justify-content: center; margin-top: clamp(18px, 4svh, 36px); flex-wrap: wrap; }
  .periodos { position: relative; max-width: 1240px; margin: 0 auto; padding: 0 32px 104px; }
  .estacoes { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .trilho { position: absolute; left: calc(100% / 12); right: calc(100% / 12); top: 19px; height: 1px; background: var(--line-strong); }
  .trilho i { display: block; height: 100%; width: calc(var(--p) * 100%); background: var(--accent); transition: width .5s ease; }
  .est a { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10px; text-decoration: none; color: var(--text); text-align: center; }
  .est .num { width: 38px; height: 38px; border-radius: 50%; background: var(--bg); border: 1px solid var(--line-strong); color: var(--text-2); display: grid; place-items: center; font-family: var(--font-mono); font-size: 13px; transition: transform .2s, border-color .2s; }
  .est.proxima .num { border-color: var(--accent); color: var(--accent); }
  .est.atual .num { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 500; }
  .est a:hover .num { border-color: var(--accent); transform: translateY(-2px); }
  .est .nome { font-size: 14px; font-weight: 500; }
  .est .sub { font-size: 12px; color: var(--muted); }
  @media (max-width: 760px) {
    .hero-in { padding: clamp(12px, 3svh, 48px) 16px; }
    .hero h1 { font-size: clamp(30px, min(9.4vw, 5.2svh), 48px); }
    .hero-sub { font-size: clamp(17px, 2.6svh, 22px); }
    .hero-pilula { font-size: 12px; padding: 5px 12px; }
    .rota-rolo { overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px; }
    .rota-lista { min-width: 356px; }
    .rota-no .rot { font-size: 11px; margin-top: 8px; letter-spacing: -.01em; }
    .hero-numeros a { min-height: 32px; font-size: 12.5px; padding: 0 10px; }
    .hero-ctas { gap: 8px; }
    .hero-ctas .bt-pri, .hero-ctas .bt-sec { min-height: 44px; padding: 0 16px; font-size: 14px; }
    .periodos { padding: 0 16px 56px; }
    .estacoes { grid-template-columns: 1fr; gap: 18px; }
    .trilho { left: 19px; right: auto; top: 19px; bottom: 19px; width: 1px; height: auto; }
    .trilho i { width: 100%; height: calc(var(--p) * 100%); transition: height .5s ease; }
    .est a { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 0 14px; text-align: left; align-items: center; }
    .est .num { grid-row: 1 / 3; }
    .est .nome { align-self: end; }
    .est .sub { align-self: start; }
  }
  @media (max-width: 760px) and (max-height: 700px) {
    .hero-marca { display: none; }
  }
</style>
