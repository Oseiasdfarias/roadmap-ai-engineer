---
import { getEntry } from 'astro:content';
import { ArrowRight, ArrowUpRight, Check } from '@lucide/astro';
import { dicasDaFase, idProgresso, rotaDe, topicosDoNivel } from '../../lib/conteudo';
import { url } from '../../lib/url';

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const MAX_POR_GRUPO = 5;
const niveis = await Promise.all(
  [1, 2, 3, 4].map(async (n) => {
    const meta = (await getEntry('niveis', String(n)))!.data;
    const fase = (await getEntry('fases', String(meta.fase)))!.data;
    const grupos = await topicosDoNivel(n);
    const dicas = await dicasDaFase(meta.fase);
    const ids = grupos.flatMap((g) => g.itens.map(idProgresso));
    return { meta, fase, grupos, dicas, ids };
  }),
);
---
<section id="niveis" class="niveis rv">
  <div class="kicker">02 — Níveis</div>

  {niveis.map((n, i) => (
    <article class="nv-grande" data-nivel-painel={n.meta.id} data-nivel-ids={n.ids.join(',')} hidden={i !== 0}>
      <div class="nv-corpo">
        <div class="nv-meta">
          <span class="etq">Nível {n.meta.id} · você está aqui</span>
          <span class="dur">{n.meta.duracao} · {n.ids.length} tópicos</span>
          <span class="cont" data-progresso-conta={n.ids.join(',')}><span data-progresso-texto>0 / {n.ids.length}</span></span>
        </div>
        <h2>{cap(n.meta.nome)}</h2>
        <p class="obj">{n.meta.objetivo}</p>
        <div class="nv-cols">
          {n.grupos.map((g) => (
            <div>
              <h3>{g.grupo}</h3>
              <ul class="topicos">
                {g.itens.slice(0, MAX_POR_GRUPO).map((t) => {
                  const id = idProgresso(t);
                  return (
                    <li>
                      <button type="button" class="chk" data-alternar={id} data-progresso-id={id} aria-pressed="false" aria-label={`Marcar como estudado: ${t.data.titulo}`}>
                        <Check aria-hidden="true" stroke-width={3.6} />
                      </button>
                      <button type="button" class="tp-nome" data-painel={id} data-progresso-id={id} aria-haspopup="dialog">
                        {t.data.titulo}
                        <span class="sr-only estado-feito"> (estudado)</span>
                      </button>
                    </li>
                  );
                })}
                {g.itens.length > MAX_POR_GRUPO && (
                  <li class="mais"><a href={url(`/nivel/${n.meta.id}/`)}>+ {g.itens.length - MAX_POR_GRUPO} tópicos</a></li>
                )}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <aside class="nv-lado" aria-label="Ao mesmo tempo, na carreira">
        <div class="rot">Ao mesmo tempo, na carreira</div>
        <div class="fase-t">Fase {n.fase.id} · {cap(n.fase.nome)}</div>
        <p>{n.fase.objetivo}</p>
        <ul class="dicas">
          {n.dicas.map((d) => (
            <li><a href={rotaDe(d)}>{d.data.titulo}<ArrowUpRight aria-hidden="true" /></a></li>
          ))}
        </ul>
        <a class="abrir" href={url(`/nivel/${n.meta.id}/`)}>Abrir o nível {n.meta.id} completo</a>
      </aside>
    </article>
  ))}

  <div class="nv-cards">
    {niveis.map((n, i) => (
      <article class="nv-card" data-nivel-card={n.meta.id} hidden={i === 0}>
        <a class="nv-card-link" href={url(`/nivel/${n.meta.id}/`)}>
          <div class="topo"><span class="k">Nível {n.meta.id}</span><span class="c" data-progresso-conta={n.ids.join(',')}><span data-progresso-texto>0 / {n.ids.length}</span></span></div>
          <h3>{cap(n.meta.nome)}</h3>
          <p>{n.meta.objetivo}</p>
          <div class="pe"><span>{n.meta.duracao} · Fase {n.fase.id} · {cap(n.fase.nome)}</span><ArrowRight aria-hidden="true" /></div>
        </a>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .niveis { max-width: 1240px; margin: 0 auto; padding: 96px 32px 40px; display: flex; flex-direction: column; gap: 20px; }
  .niveis [hidden] { display: none !important; }
  .niveis .kicker { margin: 0; }
  .nv-grande { border: 1px solid var(--line); background: var(--surface); border-radius: 20px; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); }
  .nv-corpo { padding: 40px; min-width: 0; }
  .nv-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .nv-meta .etq { font-family: var(--font-mono); font-size: 12px; color: var(--accent); border: 1px solid var(--accent-border); background: var(--accent-soft); border-radius: 6px; padding: 3px 8px; }
  .nv-meta .dur { font-size: 13px; color: var(--muted); }
  .nv-meta .cont { margin-left: auto; font-family: var(--font-mono); font-size: 12px; color: var(--text-2); }
  .nv-grande h2 { font-size: 40px; font-weight: 600; letter-spacing: -.035em; margin: 18px 0 10px; }
  .nv-grande .obj { font-size: 16px; line-height: 1.6; color: var(--text-2); margin: 0 0 28px; max-width: 560px; }
  .nv-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .nv-cols h3 { font-family: var(--font-texto); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
  .topicos { list-style: none; margin: 0; padding: 0; }
  .topicos li { display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); }
  .topicos li:last-child { border-bottom: 0; }
  .topicos .chk { width: 24px; height: 24px; border-radius: 50%; border: 0; background: transparent; padding: 0; display: grid; place-items: center; cursor: pointer; flex: none; position: relative; }
  .topicos .chk::before { content: ""; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--check-off); box-sizing: border-box; position: absolute; }
  .topicos .chk svg { position: relative; width: 10px; height: 10px; color: var(--accent-ink); opacity: 0; }
  .topicos .chk.feito::before { background: var(--accent); border-color: var(--accent); }
  .topicos .chk.feito svg { opacity: 1; }
  .topicos .tp-nome { flex: 1; min-width: 0; text-align: left; background: none; border: 0; padding: 10px 0; font-size: 14px; color: var(--text); cursor: pointer; border-radius: 6px; }
  .topicos .tp-nome:hover { color: var(--accent); }
  .topicos .tp-nome.feito { color: var(--muted); }
  .topicos .mais { padding: 10px 0 10px 34px; font-size: 14px; }
  .topicos .mais a { color: var(--accent); text-decoration: none; }
  .topicos .mais a:hover { text-decoration: underline; }
  .nv-lado { background: var(--surface-2); border-left: 1px solid var(--line); padding: 40px; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .nv-lado .rot { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .nv-lado .fase-t { font-size: 22px; font-weight: 600; letter-spacing: -.02em; }
  .nv-lado p { font-size: 14px; line-height: 1.6; color: var(--text-2); margin: 0; }
  .dicas { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .dicas a { display: flex; justify-content: space-between; align-items: center; gap: 10px; border: 1px solid var(--line-strong); border-radius: 12px; padding: 13px 14px; color: var(--text); text-decoration: none; font-size: 14px; transition: border-color .2s, transform .2s; }
  .dicas a:hover { border-color: var(--accent); transform: translateY(-1px); }
  .dicas svg { width: 14px; height: 14px; color: var(--muted); flex: none; }
  .nv-lado .abrir { margin-top: auto; padding-top: 6px; font-size: 14px; font-weight: 500; color: var(--accent); text-decoration: none; }
  .nv-lado .abrir:hover { text-decoration: underline; }
  .nv-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .nv-card { border: 1px solid var(--line); background: var(--surface); border-radius: 20px; transition: transform .2s, border-color .2s; }
  .nv-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .nv-card-link { display: flex; flex-direction: column; gap: 12px; padding: 32px; min-height: 260px; height: 100%; text-decoration: none; color: inherit; border-radius: 20px; }
  .nv-card .topo { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 12px; }
  .nv-card .k { color: var(--accent); }
  .nv-card .c { color: var(--muted); }
  .nv-card h3 { font-size: 24px; font-weight: 600; letter-spacing: -.025em; margin: 6px 0 0; }
  .nv-card p { font-size: 14px; line-height: 1.6; color: var(--text-2); margin: 0; }
  .nv-card .pe { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid var(--line); padding-top: 14px; font-size: 13px; color: var(--muted); }
  .nv-card .pe svg { width: 16px; height: 16px; color: var(--text); flex: none; transition: transform .2s; }
  .nv-card:hover .pe svg { transform: translateX(3px); }
  @media (max-width: 980px) {
    .nv-grande { grid-template-columns: 1fr; }
    .nv-lado { border-left: 0; border-top: 1px solid var(--line); }
    .nv-cards { grid-template-columns: 1fr; }
    .nv-card-link { min-height: 0; }
  }
  @media (max-width: 760px) {
    .niveis { padding: 64px 16px 24px; }
    .nv-corpo, .nv-lado { padding: 24px 20px; }
    .nv-cols { grid-template-columns: 1fr; gap: 22px; }
    .nv-grande h2 { font-size: 32px; }
  }
</style>
