---
import { getEntry } from 'astro:content';
import HeadCard from './HeadCard.astro';
import Pilula from './Pilula.astro';
import { PERIODOS } from '../data/periodos';
import { dicasDaFase, idProgresso, projetosDoNivel, topicosDoNivel } from '../lib/conteudo';
import { url } from '../lib/url';

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/** "Fase 2 continua: estágio." vira lead em negrito + resto. */
const separar = (nota: string) => {
  const i = nota.indexOf(':');
  return i === -1 ? { lead: '', resto: nota } : { lead: nota.slice(0, i + 1), resto: nota.slice(i + 1) };
};

const periodos = await Promise.all(
  PERIODOS.map(async (p) => {
    const nivel = p.nivel
      ? {
          meta: (await getEntry('niveis', String(p.nivel)))!.data,
          grupos: await topicosDoNivel(p.nivel),
          projetos: await projetosDoNivel(p.nivel),
        }
      : undefined;
    const fase = p.fase
      ? { meta: (await getEntry('fases', String(p.fase)))!.data, dicas: await dicasDaFase(p.fase) }
      : undefined;
    return { p, nivel, fase };
  }),
);
---
<section class="mapwrap" aria-labelledby="caminho">
  <div class="maptitle">
    <h2 id="caminho">O caminho completo</h2>
    <div class="legend">
      <span><i></i>cabeçalho: abre os detalhes</span>
      <span><i class="c"></i>tópico: resumo e links</span>
    </div>
  </div>
  <div class="lanes-h" aria-hidden="true"><div>O que estudar</div><div class="m"></div><div>O que fazer pela carreira</div></div>
  <div class="map">
    {periodos.map(({ p, nivel, fase }) => (
      <section class="st" data-periodo aria-label={p.nome}>
        <div class="lane">
          {nivel ? (
            <>
              <HeadCard
                href={url(`/nivel/${nivel.meta.id}/`)}
                tipo="nivel"
                numero={nivel.meta.id}
                rotulo={`Nível ${nivel.meta.id} · ${nivel.meta.duracao}`}
                titulo={cap(nivel.meta.nome)}
                ids={nivel.grupos.flatMap((g) => g.itens.map(idProgresso))}
              />
              {nivel.grupos.map((g) => (
                <>
                  <div class="grp">{g.grupo}</div>
                  <div class="pills">
                    {g.itens.map((t) => (
                      <Pilula painel={idProgresso(t)} progresso={idProgresso(t)} titulo={t.data.titulo} />
                    ))}
                  </div>
                </>
              ))}
              {nivel.projetos.length > 0 && (
                <>
                  <div class="grp">Projetos</div>
                  <div class="pills">
                    {nivel.projetos.map((pj) => (
                      <Pilula painel={`projeto:${pj.id}`} titulo={pj.data.titulo} />
                    ))}
                  </div>
                </>
              )}
            </>
          ) : (
            <div class="nota">
              {(() => { const n = separar(p.notaEstudo ?? ''); return <><b>{n.lead}</b>{n.resto}</>; })()}
            </div>
          )}
        </div>
        <div class="mid"><span class="mk" aria-hidden="true"></span><span class="per">{p.nome}</span></div>
        <div class="lane">
          {fase ? (
            <>
              <HeadCard
                href={url(`/fase/${fase.meta.id}/`)}
                tipo="fase"
                numero={fase.meta.id}
                rotulo={`Carreira · ${fase.meta.quando}`}
                titulo={cap(fase.meta.nome)}
                ids={fase.dicas.map(idProgresso)}
              />
              <div class="pills">
                {fase.dicas.map((d) => (
                  <Pilula painel={idProgresso(d)} progresso={idProgresso(d)} titulo={d.data.titulo} />
                ))}
              </div>
            </>
          ) : (
            <a class="nota" href={url(`/fase/${p.faseLink}/`)}>
              {(() => { const n = separar(p.notaCarreira ?? ''); return <><b>{n.lead}</b>{n.resto}</>; })()}
            </a>
          )}
        </div>
      </section>
    ))}
  </div>
</section>

<style is:global>
  .mapwrap { max-width: 1200px; margin: 34px auto 70px; padding: 0 28px; }
  .maptitle { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 18px; flex-wrap: wrap; }
  .maptitle h2 { font-size: 26px; letter-spacing: -.02em; margin: 0; }
  .legend { display: flex; gap: 16px; font-size: 12.5px; color: var(--muted); flex-wrap: wrap; }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 12px; height: 12px; border-radius: 4px; border: 1px solid var(--line-strong); background: var(--card); }
  .legend i.c { border-radius: 99px; }
  .lanes-h { display: grid; grid-template-columns: 1fr 110px 1fr; gap: 0 34px; margin-bottom: 8px; }
  .lanes-h div { font: 600 11.5px var(--font-texto); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 0 4px 10px; border-bottom: 1px solid var(--line); }
  .lanes-h .m { border: 0; }
  .map { position: relative; }
  .map::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 2px dotted var(--line-strong); transform: translateX(-1px); }
  .st { position: relative; display: grid; grid-template-columns: 1fr 110px 1fr; gap: 0 34px; padding: 22px 0; }
  .mid { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; padding-top: 16px; }
  .mid::before { content: ""; position: absolute; top: 36px; left: -34px; right: -34px; height: 1.5px; background: var(--line-strong); }
  .mk { position: relative; z-index: 1; width: 16px; height: 16px; border-radius: 99px; background: var(--acc); box-shadow: 0 0 0 5px var(--bg), 0 0 0 6px var(--line-strong); margin-top: 12px; }
  .per { position: relative; z-index: 1; background: var(--bg); padding: 3px 6px; font: 700 12.5px var(--font-titulo); color: var(--text); text-align: center; line-height: 1.3; }
  .lane { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .head-card { display: grid; grid-template-columns: 52px 1fr auto; gap: 12px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; text-decoration: none; color: var(--text); box-shadow: var(--shadow); transition: border-color .15s, transform .15s; }
  .head-card:hover { border-color: var(--acc); transform: translateY(-1px); }
  .head-card .ic { width: 52px; height: 52px; border-radius: 12px; background: var(--soft); display: grid; place-items: center; overflow: hidden; }
  .head-card .ic .ilus-svg { width: 64px; }
  .head-card .ic b { font-family: var(--font-titulo); font-size: 20px; color: var(--acc); }
  .head-card .k { display: block; font-size: 11.5px; color: var(--acc); font-weight: 500; }
  .head-card .tt { display: block; font-family: var(--font-titulo); font-weight: 700; font-size: 18px; letter-spacing: -.015em; margin: 2px 0 6px; }
  .head-card .pb { display: flex; align-items: center; gap: 8px; }
  .head-card .pb .track { flex: 1; max-width: 160px; height: 4px; border-radius: 9px; background: var(--line); overflow: hidden; }
  .head-card .pb .track b { display: block; height: 100%; width: 0; background: var(--acc); }
  .head-card .pb small { font-size: 11.5px; color: var(--muted); }
  .head-card .go { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; color: var(--acc); font-weight: 500; white-space: nowrap; }
  .grp { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 2px 2px -4px; }
  .pills { display: flex; flex-wrap: wrap; gap: 7px; }
  .tp { border: 1px solid var(--line); background: var(--card); color: var(--text); border-radius: 99px; padding: 6px 12px 6px 8px; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; transition: border-color .15s; }
  .tp:hover { border-color: var(--acc); }
  .tp .o { width: 14px; height: 14px; border-radius: 99px; border: 1.5px solid var(--line-strong); display: grid; place-items: center; flex: none; }
  .tp .o svg { width: 9px; height: 9px; opacity: 0; color: var(--card); }
  .tp.feito { color: var(--muted); }
  .tp.feito .o { background: var(--acc); border-color: var(--acc); }
  .tp.feito .o svg { opacity: 1; }
  .tp.pj { background: var(--soft); }
  .tp.pj .o { border-radius: 4px; }
  .nota { border: 1px dashed var(--line-strong); border-radius: 14px; padding: 14px 16px; color: var(--muted); font-size: 13.5px; line-height: 1.55; text-decoration: none; display: block; }
  a.nota:hover { border-color: var(--acc); }
  .nota b { color: var(--text); font-weight: 600; }
  @media (max-width: 900px) {
    .mapwrap { padding: 0 16px; }
    .lanes-h { display: none; }
    .map::before, .mid::before { display: none; }
    .st { grid-template-columns: 1fr; gap: 12px; }
    .mid { flex-direction: row; justify-content: flex-start; order: -1; padding-top: 0; }
    .mk { margin-top: 0; }
  }
</style>
