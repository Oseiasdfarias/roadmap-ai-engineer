---
interface Props {
  itens: Array<{ slug: string; texto: string }>;
}
const { itens } = Astro.props;
---
{itens.length > 1 && (
  <nav class="sumario" aria-label="Nesta página">
    <h2>Nesta página</h2>
    <ul>
      {itens.map((i) => <li><a href={`#${i.slug}`}>{i.texto}</a></li>)}
    </ul>
  </nav>
)}

<style>
  .sumario { position: sticky; top: 90px; font-size: 13.5px; }
  h2 { font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0 0 0 12px; border-left: 1px solid var(--line); display: grid; gap: 2px; }
  a { display: block; padding: 4px 0; color: var(--muted); text-decoration: none; line-height: 1.4; }
  a:hover { color: var(--acc); }
</style>
