---
interface Props {
  itens: Array<{ slug: string; texto: string }>;
}
const { itens } = Astro.props;
---
{itens.length > 1 && (
  <nav class="sumario" aria-label="Nesta página">
    <h2>Nesta página</h2>
    <ol>
      {itens.map((i, n) => <li><a href={`#${i.slug}`}><span class="n" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>{i.texto}</a></li>)}
    </ol>
  </nav>
)}

<style>
  .sumario { position: sticky; top: 100px; font-size: 14px; max-height: calc(100vh - 120px); overflow-y: auto; }
  h2 { font-family: var(--font-mono); font-size: 11px; font-weight: 400; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  a { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 6px; padding: 6px 0; color: var(--link); text-decoration: none; line-height: 1.4; border-radius: 4px; }
  a:hover { color: var(--accent); }
  .n { font-family: var(--font-mono); font-size: 11px; color: var(--muted); padding-top: 2px; }
  a:hover .n { color: var(--accent); }
</style>
