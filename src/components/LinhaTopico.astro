---
import type { CollectionEntry } from 'astro:content';
import { Check, ChevronDown, ArrowRight } from '@lucide/astro';
import Refs from './Refs.astro';
import { idProgresso, rotaDe } from '../lib/conteudo';

interface Props {
  entry: CollectionEntry<'topicos'> | CollectionEntry<'dicas'>;
}
const { entry } = Astro.props;
const id = idProgresso(entry);
---
<div class="row" data-progresso-id={id}>
  <button
    type="button"
    class="chk"
    data-alternar={id}
    data-progresso-id={id}
    aria-pressed="false"
    aria-label={`Marcar como estudado: ${entry.data.titulo}`}
  >
    <Check aria-hidden="true" stroke-width={3.6} />
  </button>
  <details>
    <summary>
      <span class="tt">{entry.data.titulo}</span>
      <ChevronDown class="more" aria-hidden="true" />
    </summary>
    <div class="bd">
      <p>{entry.data.resumo}</p>
      <Refs refs={entry.data.referencias} />
      <a class="ler" href={rotaDe(entry)}>Ler o resumo completo <ArrowRight aria-hidden="true" /></a>
    </div>
  </details>
</div>

<style>
  .row { display: grid; grid-template-columns: 24px minmax(0, 1fr); align-items: start; gap: 12px; border-bottom: 1px solid var(--line); }
  .row:last-child { border-bottom: 0; }
  .chk { margin-top: 12px; width: 24px; height: 24px; border-radius: 50%; border: 0; background: transparent; padding: 0; display: grid; place-items: center; cursor: pointer; position: relative; }
  .chk::before { content: ""; position: absolute; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--check-off); box-sizing: border-box; transition: background .15s, border-color .15s; }
  .chk:hover::before { border-color: var(--accent); }
  .chk :global(svg) { position: relative; width: 10px; height: 10px; opacity: 0; color: var(--accent-ink); }
  .chk.feito::before { background: var(--accent); border-color: var(--accent); }
  .chk.feito :global(svg) { opacity: 1; }
  .row.feito .tt { color: var(--muted); }
  details { min-width: 0; }
  summary { display: flex; align-items: center; gap: 10px; padding: 14px 0; cursor: pointer; list-style: none; border-radius: 6px; }
  summary::-webkit-details-marker { display: none; }
  summary:hover .tt { color: var(--accent); }
  .tt { font-weight: 500; font-size: 15px; flex: 1; min-width: 0; transition: color .15s; }
  .more { width: 16px; height: 16px; color: var(--muted); flex: none; transition: transform 0.2s; }
  details[open] .more { transform: rotate(180deg); }
  .bd { padding: 0 0 20px; color: var(--text-2); font-size: 14.5px; line-height: 1.65; }
  .bd p { margin: 0 0 14px; max-width: 68ch; }
  .ler { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; padding: 4px 0; color: var(--accent); font-weight: 500; font-size: 14px; text-decoration: none; }
  .ler:hover { text-decoration: underline; }
  .ler :global(svg) { width: 14px; height: 14px; }
  @media (prefers-reduced-motion: reduce) { .more, .tt, .chk::before { transition: none; } }
</style>
