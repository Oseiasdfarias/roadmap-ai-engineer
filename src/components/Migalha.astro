---
import { ChevronRight } from '@lucide/astro';
import { idiomaDaUrl } from '../i18n/idioma';

interface Props {
  itens: Array<{ rotulo: string; href?: string }>;
}
const { itens } = Astro.props;
---
<nav class="crumb" aria-label={idiomaDaUrl(Astro.url.pathname) === 'en' ? 'You are here' : 'Você está em'}>
  <ol>
    {itens.map((i, n) => (
      <li>
        {n > 0 && <ChevronRight aria-hidden="true" />}
        {i.href ? <a href={i.href}>{i.rotulo}</a> : <span aria-current="page">{i.rotulo}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumb { font-size: 13px; color: var(--muted); margin-bottom: 20px; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  li { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  a { color: var(--text-2); text-decoration: none; padding: 6px 0; }
  a:hover { color: var(--accent); }
  [aria-current] { color: var(--muted); }
  svg { width: 13px; height: 13px; color: var(--muted); flex: none; }
</style>
