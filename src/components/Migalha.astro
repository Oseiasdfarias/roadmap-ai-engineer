---
import { ChevronRight } from '@lucide/astro';

interface Props {
  itens: Array<{ rotulo: string; href?: string }>;
}
const { itens } = Astro.props;
---
<nav class="crumb" aria-label="Você está em">
  <ol>
    {itens.map((i, n) => (
      <li>
        {n > 0 && <ChevronRight aria-hidden="true" />}
        {i.href ? <a href={i.href}>{i.rotulo}</a> : <span aria-current="page">{i.rotulo}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumb { font-size: 13px; color: var(--muted); margin-bottom: 16px; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  li { display: inline-flex; align-items: center; gap: 6px; }
  a { color: var(--acc); text-decoration: none; }
  a:hover { text-decoration: underline; }
  svg { width: 14px; height: 14px; }
</style>
