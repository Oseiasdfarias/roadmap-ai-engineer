---
import { ArrowLeft, ArrowRight } from '@lucide/astro';

interface Props {
  anterior?: { rotulo: string; href: string };
  proximo?: { rotulo: string; href: string };
}
const { anterior, proximo } = Astro.props;
---
<nav class="pn" aria-label="Anterior e próximo">
  {anterior ? (
    <a href={anterior.href} rel="prev">
      <small><ArrowLeft aria-hidden="true" /> Anterior</small>
      <span class="r">{anterior.rotulo}</span>
    </a>
  ) : <span />}
  {proximo ? (
    <a href={proximo.href} rel="next" class="next">
      <small>Próximo <ArrowRight aria-hidden="true" /></small>
      <span class="r">{proximo.rotulo}</span>
    </a>
  ) : <span />}
</nav>

<style>
  .pn { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 72px; }
  a { display: flex; flex-direction: column; gap: 14px; border: 1px solid var(--line); border-radius: 20px; padding: 26px 28px; text-decoration: none; background: var(--surface); color: var(--text); min-width: 0; transition: border-color .2s, transform .2s; }
  a:hover { border-color: var(--accent); transform: translateY(-2px); }
  small { display: flex; align-items: center; gap: 8px; color: var(--accent); font-family: var(--font-mono); font-size: 12px; }
  .r { font-size: 20px; font-weight: 600; letter-spacing: -.02em; line-height: 1.25; }
  .next { text-align: right; align-items: flex-end; }
  svg { width: 14px; height: 14px; }
  @media (max-width: 640px) {
    .pn { grid-template-columns: 1fr; gap: 12px; margin-top: 56px; }
    .pn > span { display: none; }
    a { padding: 20px 22px; }
    .r { font-size: 17px; }
  }
  @media (prefers-reduced-motion: reduce) { a:hover { transform: none; } }
</style>
