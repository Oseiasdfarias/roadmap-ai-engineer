---
import { ArrowLeft, ArrowRight } from '@lucide/astro';

interface Props {
  anterior?: { rotulo: string; href: string };
  proximo?: { rotulo: string; href: string };
}
const { anterior, proximo } = Astro.props;
---
<nav class="pn" aria-label="Anterior e próximo">
  {anterior ? (
    <a href={anterior.href} rel="prev">
      <small><ArrowLeft aria-hidden="true" /> Anterior</small>
      {anterior.rotulo}
    </a>
  ) : <span />}
  {proximo ? (
    <a href={proximo.href} rel="next" class="next">
      <small>Próximo <ArrowRight aria-hidden="true" /></small>
      {proximo.rotulo}
    </a>
  ) : <span />}
</nav>

<style>
  .pn { display: flex; justify-content: space-between; margin-top: 18px; gap: 12px; }
  .pn > span { flex: 1; }
  a { flex: 1; border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; text-decoration: none; background: var(--card); color: var(--text); font-weight: 500; }
  a:hover { border-color: var(--acc); }
  small { display: flex; align-items: center; gap: 4px; color: var(--muted); font-size: 12px; font-weight: 400; }
  .next { text-align: right; }
  .next small { justify-content: flex-end; }
  svg { width: 13px; height: 13px; }
</style>
