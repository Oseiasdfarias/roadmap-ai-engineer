---
import { ArrowRight } from '@lucide/astro';
import Ilustracao from './Ilustracao.astro';

interface Props {
  href: string;
  tipo: 'nivel' | 'fase';
  numero: number;
  rotulo: string;
  titulo: string;
  /** Ids de progresso do bloco, para a mini barra. */
  ids: string[];
}
const { href, tipo, numero, rotulo, titulo, ids } = Astro.props;
---
<a class="head-card" href={href}>
  <span class="ic">
    {tipo === 'nivel' ? <Ilustracao nome={`icone-${numero}`} /> : <b>{numero}</b>}
  </span>
  <span>
    <span class="k">{rotulo}</span>
    <span class="tt">{titulo}</span>
    <span class="pb" data-progresso-conta={ids.join(',')}>
      <span class="track"><b data-progresso-barra></b></span>
      <small data-progresso-texto>0/{ids.length}</small>
    </span>
  </span>
  <span class="go">Detalhes <ArrowRight aria-hidden="true" size={14} /></span>
</a>
